# Copy these into Coolify's Environment Variables for the compose deployment.

APP_PORT=8317

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Super admin — the only credentials in the system; Stillora has no user
# accounts. ADMIN_EMAILS is comma-separated if several people need the panel.
ADMIN_EMAILS=you@example.com
ADMIN_PASSWORD=

POSTGRES_DB=stillora
POSTGRES_USER=stillora
POSTGRES_PASSWORD=change-this-password

# Optional public URL if/when you expose saved media from /data/stillora.
PUBLIC_MEDIA_BASE_URL=https://your-domain.com/media
