# Copy this file to .env.local and fill in the values.
#
# Stillora has no user accounts — there is no sign-up, no sign-in and no OAuth.
# The admin panel is the only thing that authenticates, and these are the only
# credentials the system has.

# Signing key for the admin session cookie. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# --- Super admin -------------------------------------------------------------
# Who may open /admin, and the shared password they sign in with. Both must
# match at /admin/login. ADMIN_EMAILS is comma-separated for several admins.
ADMIN_EMAILS=you@example.com
ADMIN_PASSWORD=

# Crash reports accepted per IP per minute (default 30). Raise it if a busy
# deployment legitimately reports more than that from one address.
ERROR_REPORT_RATE_LIMIT=

# --- Database ----------------------------------------------------------------
# Postgres holds the admin dashboard's analytics, exports and error log.
# Locally, `docker compose up -d postgres` plus a published port, or:
#   docker run -d --name stillora-pg-dev -p 55432:55432 \
#     -e POSTGRES_DB=stillora -e POSTGRES_USER=stillora \
#     -e POSTGRES_PASSWORD=stillora-dev -e PGPORT=55432 \
#     postgres:16-alpine postgres -p 55432
DATABASE_URL=postgresql://stillora:stillora-dev@localhost:55432/stillora
# Set to "require" for managed providers that use a self-signed certificate.
DATABASE_SSL=

# --- Media -------------------------------------------------------------------
# Where uploads and rendered exports are written.
MEDIA_ROOT=/data/stillora
PUBLIC_MEDIA_BASE_URL=

# --- Deployment (Coolify / VPS) ----------------------------------------------
APP_PORT=8317
POSTGRES_DB=stillora
POSTGRES_USER=stillora
POSTGRES_PASSWORD=change-me
