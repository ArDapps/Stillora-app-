# Copy this file to .env.local and fill in the values.

# Session signing key. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Vercel Blob storage token. Required on Vercel for durable uploads/exports.
# Create/connect a Blob store in Vercel, then add BLOB_READ_WRITE_TOKEN to project env vars.
BLOB_READ_WRITE_TOKEN=

# Google OAuth 2.0 "Web application" client credentials.
# Create at https://console.cloud.google.com/apis/credentials
#
# Authorized redirect URIs to register on that client:
#   http://localhost:3000/api/auth/callback/google
#   https://stillora.loopara.app/api/auth/callback/google
#
# (Optional) Authorized JavaScript origins:
#   http://localhost:3000
#   https://stillora.loopara.app
GOOGLE_CLIENT_ID=718272031198-jcl994t1b9ucib32k08hb3rc5v29ngur.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
