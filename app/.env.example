# Copy this file to .env.local and fill in the values.

# Session signing key. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth 2.0 "Web application" client credentials.
# Create at https://console.cloud.google.com/apis/credentials
#
# Authorized redirect URIs to register on that client:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.com/api/auth/callback/google
#
# (Optional) Authorized JavaScript origins:
#   http://localhost:3000
#   https://your-domain.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional for Coolify/VPS deployments.
APP_PORT=8317
POSTGRES_DB=stillora
POSTGRES_USER=stillora
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://stillora:change-me@postgres:55432/stillora
MEDIA_ROOT=/data/stillora
PUBLIC_MEDIA_BASE_URL=
